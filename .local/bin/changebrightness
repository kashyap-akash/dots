#!/bin/sh

case "$1" in
  up)   brightnessctl set +5% ;;
  down) brightnessctl set 5%- ;;
  *) exit 1 ;;
esac

brightness=$(brightnessctl g)
max=$(brightnessctl m)
brightness=$(( brightness * 100 / max ))

dunstify -a changebrightness -u low -r 9991 \
  -h int:value:"$brightness" \
  "Brightness: ${brightness}%" \
  -t 2000
