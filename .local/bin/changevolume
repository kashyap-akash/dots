#!/bin/sh

# Increment, decrement, or mute the volume and send a notification
# of the current volume level.
#
# send_notification() {
# 	volume=$(pamixer --get-volume)
#   case 1 in
# 	$((volume >= 70)) ) icon=" " ;;
# 	$((volume >= 30)) ) icon=" " ;;
# 	$((volume >= 1)) ) icon=" " ;;
# 	* ) echo 🔇 && exit ;;
# esac
#
# 	dunstify -a "changevolume" -u low -r 9993 -h int:value:"$volume" " Volume: ${volume}%" -t 2000
# }
#
# case $1 in
# up)
# 	# set the volume on (if it was muted)
# 	pamixer -u
# 	pamixer -i 5 
# 	send_notification "$1"
# 	;;
# down)
# 	pamixer -u
# 	pamixer -d 5 
# 	send_notification "$1"
# 	;;
# mute)
# 	pamixer -t
# 	if eval "$(pamixer --get-mute)"; then
# 		dunstify -a "changevolume" -t 2000 -r 9993 -u low " 🔇 muted" 
# 	else
# 		send_notification
# 	fi
# 	;;
# esac
#
case "$1" in
  up)   pamixer -u -i 5 ;;
  down) pamixer -u -d 5 ;;
  mute) pamixer -t ;;
  *) exit 1 ;;
esac

muted=$(pamixer --get-mute)

[ "$muted" = "true" ] && {
  dunstify -a changevolume -u low -r 9993 "🔇 Muted" -t 2000
  exit 0
}

volume=$(pamixer --get-volume)

dunstify -a changevolume -u low -r 9993 \
  -h int:value:"$volume" \
  "Volume: ${volume}%" \
  -t 2000
