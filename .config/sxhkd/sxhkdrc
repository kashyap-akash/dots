# Reload sxhkd

super + shift + Escape
    pkill sxhkd && setsid sxhkd

#MEDIA KEYS

XF86AudioRaiseVolume
	changevolume up && pkill -RTMIN+6 dwmblocks 

XF86AudioLowerVolume
	changevolume down && pkill -RTMIN+6 dwmblocks

XF86AudioMute
	changevolume mute && pkill -RTMIN+6 dwmblocks

XF86AudioPlay
    playerctl play-pause

XF86AudioPause
    playerctl pause

XF86AudioNext
    playerctl next

XF86AudioPrev
    playerctl previous

XF86AudioMicMute
    mic-status

#BRIGHTNESS KEYS

XF86MonBrightnessUp
	changebrightness up

XF86MonBrightnessDown
	changebrightness down

#DESKTOP KEYS

super + Return
    st
super + b 
    brave --incognito
super + shift + b 
    brave 
super + shift + a 
    st -e musikcube
super + shift + s
    st -e ncspot   
super + e
    st -e yazi
super + shift + q
    slock
super + shift + p
    screenshot select
super + control + p
    screenshot full
super + control + w
    st -e nmtui
super + shift + w
    ~/.local/bin/wifi-toggle.sh
super + control +q
    ~/.local/bin/killwm
super + o
    xdg-open "$(grep -v '^#' ~/dots/bookmarks | dmenu -i -l 50 | cut -d' ' -f1)"
   # xdotool type --delay 1 $(grep -v '^#' ~/dots/bookmarks | dmenu -i -l 50 | cut -d' ' -f1)
