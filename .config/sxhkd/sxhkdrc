# Reload sxhkd

super + shift + Escape
    pkill sxhkd && setsid sxhkd

#MEDIA KEYS

XF86AudioRaiseVolume
	changevolume up 

XF86AudioLowerVolume
	changevolume down 

XF86AudioMute
	changevolume mute

XF86AudioPlay
    playerctl play-pause

XF86AudioPause
    playerctl pause

XF86AudioNext
    playerctl next

XF86AudioPrev
    playerctl previous


#BRIGHTNESS KEYS

XF86MonBrightnessUp
	changebrightness up

XF86MonBrightnessDown
	changebrightness down

#DESKTOP KEYS

super + Return
    st
super + b 
    brave --incognito
super + shift + b 
    brave 
super + shift + a 
    st -e musikcube
super + shift + s
    st -e ncspot   
super + e
    st -e yazi
super + shift + q
    slock
super + shift + p
    scrot --select --quality 100 ~/pictures/screenshots/%Y-%m-%d-%T-screenshot.png
super + control + p 
    scrot --quality 100 ~/pictures/screenshots/%Y-%m-%d-%T-screenshot.png
super + control + w
    st -e nmtui
super + shift + w
    ~/.local/bin/wifi-toggle.sh
super + control +q
    ~/.local/bin/killwm
super + o
    xdg-open "$(grep -v '^#' ~/dots/bookmarks | dmenu -i -l 50 | cut -d' ' -f1)"
   # xdotool type --delay 1 $(grep -v '^#' ~/dots/bookmarks | dmenu -i -l 50 | cut -d' ' -f1)
