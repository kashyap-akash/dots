#!/bin/sh

DOTS="$HOME/dots"

# Ensure directories exist
mkdir -p "$HOME/.config"
mkdir -p "$HOME/.local/bin"
mkdir -p "$HOME/.local/src"

# CONFIG FILES
configs="hypr lf MangoHud musikcube nvim sxhkd waybar cava dunst glava picom wal yazi"

for cfg in $configs; do
    if [ -e "$HOME/.config/$cfg" ] && [ ! -L "$HOME/.config/$cfg" ]; then
        rm -rf "$HOME/.config/$cfg"
    fi
    ln -sf "$DOTS/.config/$cfg" "$HOME/.config/"
done

ln -sf "$DOTS/.xinitrc" "$HOME/"
ln -sf "$DOTS/.zshrc" "$HOME/"

# SCRIPTS
scripts="wiof wion update-library.sh sb-volume sb-internet sb-cpu sb-clock sb-battery pkgls mirrorup looknfeel look changebrightness changevolume extradim limitvol lfub worldtime killwm"

for s in $scripts; do
    ln -sf "$DOTS/.local/bin/$s" "$HOME/.local/bin/"
done

# PROGRAMS
programs="st dwmblocks dwm dmenu"

for p in $programs; do
    ln -sf "$DOTS/.local/src/$p" "$HOME/.local/src/"
done
